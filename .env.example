# the ip people type in the browser. deploy.sh fills this in.
# 127.0.0.1 counts as "not set": deploy.sh will detect the ip instead.
PUBLIC_IP=127.0.0.1

# how many cores the rust build may use. a full ./scripts/deploy.sh overwrites this every run
# (ram / 1.5 GB, capped at the core count); partial runs and --pull compute the same
# number but leave this line alone. to force a value: CARGO_BUILD_JOBS=2 ./scripts/deploy.sh
CARGO_BUILD_JOBS=1

# where ./scripts/deploy.sh gets the images. empty IMAGES: the registry the git remote implies
# (github.com/<you>/… → ghcr.io/<you>/), where the github action pushes them on every push
# to main. set it for another registry. TAG is what the last deploy ran (a commit, or a release
# like v12: the action tags every image with its v<n>); deploy.sh writes it.
# `./scripts/deploy.sh --build` compiles the images here instead and ignores both.
IMAGES=
TAG=

# what this box is called in /api/health and in every stored error. empty: deploy.sh fills in
# this machine's hostname. use prod, dev, ... if you prefer.  see docs/debugging.md
ENV_NAME=

# who may read /api/errors and open /admin: account names, comma separated. empty = nobody.
# each name needs an account on this box (sign up, or ./scripts/deploy.sh passwd <name>), else the api drops it at boot
ADMIN_NAMES=
# a machine's key for /api/errors (Authorization: Bearer ...). empty = off.  make one: openssl rand -hex 32
# 16 characters at least: a shorter one is ignored, with a warn line in the api log
OPS_TOKEN=

# fake streams for styling and debugging: gifs bouncing around, named dummy-mango, dummy-pixel, ...
# set a count and any password, then: ./scripts/deploy.sh dummy
# the password is what lets the dummy box publish dummy-* names. nobody else can.
DUMMY_STREAMS=0
DUMMY_PASSWORD=
# optional: your own names instead, comma separated
DUMMY_NAMES=

# where objects go. off (the default): the s3 container in docker-compose (seaweedfs),
# bucket "stream", no aws bill. set a url to use a real bucket instead, and then the
# key, the secret and the bucket name. the container still runs either way; a url
# only changes where the api sends.
#   https://s3.us-east-1.amazonaws.com
#   https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=off
S3_BUCKET=stream
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# empty: path-style, except amazonaws.com which wants virtual-hosted. 1 or 0 forces it.
# the container always uses path-style, and this line does not apply to it.
S3_PATH_STYLE=

# keep chat lines in postgres, so a room can be scrolled past the last 500, searched,
# and jumped to. empty or 0: redis only (the last 500, gone a week after the last line).
# 1 turns it on. the chat process reads this. the api process does not.
CHAT_PERSIST=

# how many groups one login may own: the ones it made plus the ones it was named owner of.
# empty: 2. the pages offer create under it, and the api refuses at it. see docs/groups.md
GROUPS_PER_OWNER=
