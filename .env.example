# the ip people type in the browser. deploy.sh fills this in.
# 127.0.0.1 counts as "not set": deploy.sh will detect the ip instead.
PUBLIC_IP=127.0.0.1

# how many cores the rust build may use. a full ./deploy.sh overwrites this every run
# (ram / 1.5 GB, capped at the core count); partial runs and --pull compute the same
# number but leave this line alone. to force a value: CARGO_BUILD_JOBS=2 ./deploy.sh
CARGO_BUILD_JOBS=1

# what this box is called in /api/health and in every stored error. empty: deploy.sh fills in
# this machine's hostname. use prod, dev, ... if you prefer.  see docs/debugging.md
ENV_NAME=

# who may read /api/errors and open /admin: account names, comma separated. empty = nobody.
# each name needs an account on this box (sign up, or ./deploy.sh passwd <name>), else the api drops it at boot
ADMIN_NAMES=
# a machine's key for /api/errors (Authorization: Bearer ...). empty = off.  make one: openssl rand -hex 32
# 16 characters at least: a shorter one is ignored, with a warn line in the api log
OPS_TOKEN=

# fake streams for styling and debugging: bouncing boxes named dummy-mango, dummy-pixel, ...
# set a count and any password, then: ./deploy.sh dummy
# the password is what lets the dummy box publish dummy-* names. nobody else can.
DUMMY_STREAMS=0
DUMMY_PASSWORD=
# optional: your own names instead, comma separated
DUMMY_NAMES=
