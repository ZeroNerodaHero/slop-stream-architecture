{
	auto_https disable_redirects
	skip_install_trust

	servers :443 {
		protocols h1 h2

		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

(real_ip) {
	header_up X-Forwarded-For {client_ip}
}

https://{$STATS_HOST:stats.nodentity.xyz} {
	tls {$STATS_TLS:internal}
	log
	encode zstd gzip

	header {
		Cache-Control "private, no-store"
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@public expression `{env.STATS_PUBLIC} == "true"`
	handle @public {
		reverse_proxy monitor:3002 {
			import real_ip
			header_down -Cache-Control
		}
	}

	@off expression `{env.STATS_BASIC_AUTH_USER} in ["", "statsoff"] || {env.STATS_BASIC_AUTH_HASH} in ["", "statsoff"]`
	handle @off {
		respond "stats is off: STATS_BASIC_AUTH_USER and STATS_BASIC_AUTH_HASH are not set, and STATS_PUBLIC is not true" 503
	}

	handle {
		basic_auth {
			{$STATS_BASIC_AUTH_USER:statsoff} {$STATS_BASIC_AUTH_HASH:statsoff}
		}
		reverse_proxy monitor:3002 {
			import real_ip
			header_down -Cache-Control
		}
	}
}
