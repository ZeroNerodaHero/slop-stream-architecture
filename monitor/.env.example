# the boxes to watch: name=url, comma separated. the name is what the page and the alerts call it
TARGETS=prod=https://1.2.3.4,dev=https://5.6.7.8

# each box's OPS_TOKEN (the one in its own .env), so the page can show its error reports. optional.
# a box without one still gets watched, just without that table
OPS_TOKENS=prod=,dev=

# where down and up go: a url that takes json {"content": "..."} (a discord webhook does;
# so does anything that reads "text"). empty = nowhere, the page and the log still show them
ALERT_WEBHOOK=

# how often, in seconds, and how many failed rounds in a row make "down"
CHECK_EVERY_SECS=15
ERRORS_EVERY_SECS=60
DOWN_AFTER=3

# the page, on this box's loopback. reach it over ssh -L
MONITOR_PORT=3002

# how many cores the rust build may use. 1 is safe on a small box
CARGO_BUILD_JOBS=1
