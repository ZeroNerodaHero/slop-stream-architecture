{
	# no hostnames here, so nothing to get certs for. the cert is ours below.
	auto_https off

	# compose publishes 443/tcp only, so don't advertise http/3
	servers :443 {
		protocols h1 h2

		# cloudflare's ranges, from cloudflare.com/ips-v4 and /ips-v6. refresh when they change.
		# only a request from one of them gets its CF-Connecting-IP trusted as the client ip; a
		# direct request can't spoof it, the header is ignored. the proxies below then pin
		# X-Forwarded-For to that client ip (real_ip snippet)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		# read the header right to left, stopping at the first ip that isn't a trusted proxy
		trusted_proxies_strict
	}
}

# overwrite X-Forwarded-For with the client ip caddy resolved (the servers block above).
# caddy would otherwise keep a trusted proxy's own X-Forwarded-For and append, so a visitor
# could prepend a fake first entry, and api/src/ratelimit.rs and auth.rs read the first
(real_ip) {
	header_up X-Forwarded-For {client_ip}
}

# http://<ip> -> https://<ip>
http:// {
	redir https://{host}{uri}
}

:443 {
	tls /certs/cert.pem /certs/key.pem
	log

	# the home list, served by the home container from its table (api/src/home.rs). an exact
	# path: /api/streams/<name>/... stays the api's. caddy puts the longer path matcher first
	handle /api/streams {
		reverse_proxy home:4100 {
			import real_ip
		}
	}

	# json api. path kept, so /api/x -> api:4000/api/x
	handle /api/* {
		reverse_proxy api:4000 {
			import real_ip
		}
	}

	# video setup websocket. reverse_proxy does the upgrade on its own.
	handle /ws {
		reverse_proxy video:7880 {
			import real_ip
		}
	}

	# voice channel websocket, the voice container (video/src/voice.rs), which listens at /ws.
	# an exact path, like /ws. a 502 until the voice profile is up (docker-compose.yml)
	handle /voice {
		rewrite * /ws
		reverse_proxy voice:7881 {
			import real_ip
		}
	}

	# text chat websocket, one per viewer
	handle /chat/* {
		reverse_proxy chat:4100 {
			import real_ip
		}
	}

	# the events websocket: presence and pushes, one per browser, open on every page. its own
	# container, the api binary run as `api events`. an exact path, like /ws. see docs/status.md
	handle /events {
		reverse_proxy events:4100 {
			import real_ip
		}
	}

	# the picture of each live stream, made on the video machine
	handle /thumb/* {
		reverse_proxy video:7880 {
			import real_ip
		}
	}

	# the one page the api serves: the same index.html, with a <title> and og:* tags
	# for that name so a shared link gets a preview card, and the profile filled in
	# before react boots. api/src/profile.rs. everything else is the spa below.
	handle /watch/* {
		encode zstd gzip
		reverse_proxy api:4000 {
			import real_ip
		}
	}

	# the api is down (./scripts/deploy.sh api, a crash): a shared watch link would be a bare
	# 502. serve the plain index.html from the volume instead, so the spa boots and
	# keeps checking on its own. that one fetch has no preview tags; a bot that
	# unfurls right then gets the generic card. every other route keeps its error.
	handle_errors {
		handle /watch/* {
			@down expression `{err.status_code} in [502, 503, 504]`
			handle @down {
				root * /srv
				header Cache-Control "no-cache"
				rewrite * /index.html
				file_server
			}
		}
		# a missing asset (a tab on an old build asking for a chunk the new publish removed):
		# a 404 that is not kept, so the next publish or a rollback is asked again
		handle /assets/* {
			header Cache-Control "no-store"
			respond "{err.status_code} {err.status_text}"
		}
	}

	# the pages: a single-page app built by vite into /srv.
	# hashed assets can be cached forever, but only the ones that are there: a miss is a
	# 404 (above), not the spa with this header on it. with the catch-all's fallback a tab
	# on an old build asking for a removed chunk would cache index.html, immutable, a year.
	handle /assets/* {
		root * /srv
		@hit file
		header @hit Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		# the build's brotli 11 beside each asset (scripts/precompress.mjs), to a browser that
		# takes br; the rest are compressed on the fly as before. ~23% fewer bytes for the main
		# bundle, which a cold load gets in tcp slow start (docs/debugging.md "Watch startup timings")
		file_server {
			precompressed br
		}
	}

	# everything else is index.html, which must always be re-checked so a deploy never
	# leaves someone running old js against a new api.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}
}
