{
	# no hostnames here, so nothing to get certs for. the cert is ours below.
	auto_https off

	# compose publishes 443/tcp only, so don't advertise http/3
	servers :443 {
		protocols h1 h2
	}
}

# http://<ip> -> https://<ip>
http:// {
	redir https://{host}{uri}
}

:443 {
	tls /certs/cert.pem /certs/key.pem
	log

	# json api. path kept, so /api/x -> api:4000/api/x
	handle /api/* {
		reverse_proxy api:4000
	}

	# video setup websocket. reverse_proxy does the upgrade on its own.
	handle /ws {
		reverse_proxy video:7880
	}

	# text chat websocket, one per viewer
	handle /chat/* {
		reverse_proxy chat:4100
	}

	# the picture of each live stream, made on the video machine
	handle /thumb/* {
		reverse_proxy video:7880
	}

	# the one page the api serves: the same index.html, with a <title> and og:* tags
	# for that name so a shared link gets a preview card, and the profile filled in
	# before react boots. api/src/profile.rs. everything else is the spa below.
	handle /watch/* {
		encode zstd gzip
		reverse_proxy api:4000
	}

	# the api is down (./deploy.sh api, a crash): a shared watch link would be a bare
	# 502. serve the plain index.html from the volume instead, so the spa boots and
	# keeps checking on its own. that one fetch has no preview tags; a bot that
	# unfurls right then gets the generic card. every other route keeps its error.
	handle_errors {
		handle /watch/* {
			@down expression `{err.status_code} in [502, 503, 504]`
			handle @down {
				root * /srv
				header Cache-Control "no-cache"
				rewrite * /index.html
				file_server
			}
		}
	}

	# the pages: a single-page app built by vite into /srv.
	# hashed assets can be cached forever; index.html must always be re-checked
	# so a deploy never leaves someone running old js against a new api.
	handle {
		root * /srv
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}
}
