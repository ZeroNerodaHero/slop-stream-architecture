{
	# no hostnames here, so nothing to get certs for. the cert is ours below.
	auto_https off

	# compose publishes 443/tcp only, so don't advertise http/3
	servers :443 {
		protocols h1 h2
	}
}

# http://<ip> -> https://<ip>
http:// {
	redir https://{host}{uri}
}

:443 {
	tls /certs/cert.pem /certs/key.pem
	log

	# the home list, served by the home container from its table (api/src/home.rs). an exact
	# path: /api/streams/<name>/... stays the api's. caddy puts the longer path matcher first
	handle /api/streams {
		reverse_proxy home:4100
	}

	# json api. path kept, so /api/x -> api:4000/api/x
	handle /api/* {
		reverse_proxy api:4000
	}

	# video setup websocket. reverse_proxy does the upgrade on its own.
	handle /ws {
		reverse_proxy video:7880
	}

	# text chat websocket, one per viewer
	handle /chat/* {
		reverse_proxy chat:4100
	}

	# the events websocket: presence and pushes, one per browser, open on every page. its own
	# container, the api binary run as `api events`. an exact path, like /ws. see docs/status.md
	handle /events {
		reverse_proxy events:4100
	}

	# the picture of each live stream, made on the video machine
	handle /thumb/* {
		reverse_proxy video:7880
	}

	# the one page the api serves: the same index.html, with a <title> and og:* tags
	# for that name so a shared link gets a preview card, and the profile filled in
	# before react boots. api/src/profile.rs. everything else is the spa below.
	handle /watch/* {
		encode zstd gzip
		reverse_proxy api:4000
	}

	# the api is down (./scripts/deploy.sh api, a crash): a shared watch link would be a bare
	# 502. serve the plain index.html from the volume instead, so the spa boots and
	# keeps checking on its own. that one fetch has no preview tags; a bot that
	# unfurls right then gets the generic card. every other route keeps its error.
	handle_errors {
		handle /watch/* {
			@down expression `{err.status_code} in [502, 503, 504]`
			handle @down {
				root * /srv
				header Cache-Control "no-cache"
				rewrite * /index.html
				file_server
			}
		}
		# a missing asset (a tab on an old build asking for a chunk the new publish removed):
		# a 404 that is not kept, so the next publish or a rollback is asked again
		handle /assets/* {
			header Cache-Control "no-store"
			respond "{err.status_code} {err.status_text}"
		}
	}

	# the pages: a single-page app built by vite into /srv.
	# hashed assets can be cached forever, but only the ones that are there: a miss is a
	# 404 (above), not the spa with this header on it. with the catch-all's fallback a tab
	# on an old build asking for a removed chunk would cache index.html, immutable, a year.
	handle /assets/* {
		root * /srv
		@hit file
		header @hit Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# everything else is index.html, which must always be re-checked so a deploy never
	# leaves someone running old js against a new api.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}
}
